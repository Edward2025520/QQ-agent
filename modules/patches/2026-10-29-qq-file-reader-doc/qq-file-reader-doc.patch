 /** 调本机 Python 抽文本。失败抛出带人话的错误。 */
+/** 跑一个外部命令，带超时；永不 reject，返回 {ok,out,err}。 */
+function runBin(cmd, args, timeoutMs) {
+  return new Promise((resolve) => {
+    let child;
+    try {
+      child = spawn(cmd, args, { windowsHide: true });
+    } catch (error) {
+      resolve({ ok: false, out: '', err: String(error?.message ?? error) });
+      return;
+    }
+    let out = '';
+    let err = '';
+    const timer = setTimeout(() => {
+      try { child.kill(); } catch { /* ignore */ }
+      resolve({ ok: false, out, err: 'timeout' });
+    }, timeoutMs);
+    child.stdout?.on('data', (d) => { out += String(d); });
+    child.stderr?.on('data', (d) => { err += String(d); });
+    child.on('error', (e) => { clearTimeout(timer); resolve({ ok: false, out, err: String(e?.message ?? e) }); });
+    child.on('close', (code) => { clearTimeout(timer); resolve({ ok: code === 0, out, err }); });
+  });
+}
+
+/**
+ * 老的 .doc/.rtf/.wps 先转成 docx 再走 extract()，保留表格结构；
+ * LibreOffice 不可用或超时 → 退 antiword 出纯文本；再不行给明确建议。
+ */
+async function convertLegacy(file, ext) {
+  const dir = path.dirname(file);
+  const profile = path.join(TMP_DIR, `lo-profile-${process.pid}-${Date.now()}`);
+  const res = await runBin('soffice', [
+    '--headless', '--norestore', '--nolockcheck', '--nodefault', '--nofirststartwizard',
+    `-env:UserInstallation=file://${profile}`,
+    '--convert-to', 'docx', '--outdir', dir, file
+  ], 45_000);
+  try { fs.rmSync(profile, { recursive: true, force: true }); } catch { /* ignore */ }
+
+  const out = path.join(dir, `${path.basename(file, ext)}.docx`);
+  if (res.ok && fs.existsSync(out)) return out;
+
+  const aw = await runBin('antiword', [file], 20_000);
+  if (aw.ok && aw.out.trim()) {
+    const txt = `${file}.txt`;
+    fs.writeFileSync(txt, aw.out, 'utf8');
+    return txt;
+  }
+  throw new Error('这份文件转不出来（可能已损坏，或是图片版文档）。存成 docx 再发我，或者把内容贴过来');
+}
