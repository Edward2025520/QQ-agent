+// 配图校验：把「只认几个图床」换成「任意公网图片，但先验证」。
+//
+// 为什么改：原来的 ALLOWED_IMAGE_HOSTS 只有 aigengtu / soutula 两个域名，搜图工具
+// 返回的图基本都在别处，于是 publish_qzone_post 静默降级成纯文字 —— 用户看到的
+// 就是"图片被拦住了，说说发不出去（带图）"。
+//
+// 安全边界由运行时检查承担，而不是域名白名单：
+//   · 只接受 http(s)，拒绝 localhost / 私网字面量 / .local
+//   · HEAD 粗筛（405 时退回 GET Range），content-type 必须是图片，长度有上限
+//   · 选中后完整下载复核（再次验 mime/大小），并算 sha256 用于查重
+import crypto from 'node:crypto';
+import fs from 'node:fs';
+import path from 'node:path';
+
+const UA = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36';
+const IMAGE_MIME = /^image\/(jpeg|jpg|png|webp|gif)$/i;
+const DEFAULT_MAX_BYTES = 8 * 1024 * 1024;
+const USED_TTL_MS = 90 * 86400_000;
+
+function dataRoot() {
+  return process.env.QQ_AGENT_DATA_DIR || path.join(process.cwd(), 'data');
+}
+
+function usedFile() {
+  return path.join(dataRoot(), 'qzone', 'used-images.json');
+}
+
+/** 公网 http(s)？只做字面量判断，不解析 DNS（解析留给上层 safe-fetch）。 */
+export function isPublicHttpUrl(url) {
+  let u;
+  try { u = new URL(String(url || '')); } catch { return false; }
+  if (u.protocol !== 'http:' && u.protocol !== 'https:') return false;
+  const h = u.hostname.toLowerCase().replace(/^\[|\]$/g, '');
+  if (!h) return false;
+  if (h === 'localhost' || h.endsWith('.localhost') || h.endsWith('.local') || h.endsWith('.internal')) return false;
+  if (h === '::1' || h === '0.0.0.0') return false;
+  if (/^127\./.test(h) || /^10\./.test(h) || /^192\.168\./.test(h)) return false;
+  if (/^172\.(1[6-9]|2\d|3[01])\./.test(h)) return false;
+  if (/^169\.254\./.test(h)) return false;
+  return true;
+}
+
+/** HEAD 粗筛；HEAD 不被支持时退回带 Range 的 GET。 */
+export async function headCheck(fetchImpl, url, { maxBytes = DEFAULT_MAX_BYTES } = {}) {
+  if (!isPublicHttpUrl(url)) return { ok: false, reason: '不是公网 http(s) 地址' };
+  const opts = { headers: { 'User-Agent': UA, accept: 'image/*' }, signal: AbortSignal.timeout(15_000) };
+  let res = null;
+  let err = '';
+  try {
+    res = await fetchImpl(url, { ...opts, method: 'HEAD' });
+  } catch (e) { err = String(e?.message ?? e); }
+  if (!res || res.status >= 400) {
+    try {
+      res = await fetchImpl(url, { headers: { ...opts.headers, range: 'bytes=0-1023' }, signal: AbortSignal.timeout(15_000) });
+    } catch (e) { err = String(e?.message ?? e); }
+  }
+  if (!res) return { ok: false, reason: `请求失败${err ? '（' + err + '）' : ''}` };
+  if (res.status >= 400) return { ok: false, reason: `HTTP ${res.status}` };
+  const mime = String(res.headers.get('content-type') || '').toLowerCase();
+  if (!IMAGE_MIME.test(mime)) return { ok: false, reason: `不是图片（${mime || '未知类型'}）` };
+  const len = Number(res.headers.get('content-length') || 0);
+  if (len && len > maxBytes) return { ok: false, reason: `太大（${Math.round(len / 1048576)}MB）` };
+  return { ok: true, mime, bytes: len || null };
+}
+
+/** 完整下载、复核并算 sha256。 */
+export async function downloadHash(fetchImpl, url, { maxBytes = DEFAULT_MAX_BYTES } = {}) {
+  if (!isPublicHttpUrl(url)) return { ok: false, reason: '不是公网 http(s) 地址' };
+  let res;
+  try {
+    res = await fetchImpl(url, {
+      headers: { 'User-Agent': UA, accept: 'image/*' },
+      signal: AbortSignal.timeout(30_000)
+    });
+  } catch (e) {
+    return { ok: false, reason: `下载失败（${String(e?.message ?? e)}）` };
+  }
+  if (!res || res.status >= 400) return { ok: false, reason: `下载失败 HTTP ${res?.status ?? '?'}` };
+  const mime = String(res.headers.get('content-type') || '').toLowerCase();
+  if (!IMAGE_MIME.test(mime)) return { ok: false, reason: `不是图片（${mime || '未知类型'}）` };
+  let buf;
+  try { buf = Buffer.from(await res.arrayBuffer()); } catch (e) {
+    return { ok: false, reason: `读取失败（${String(e?.message ?? e)}）` };
+  }
+  if (!buf.length) return { ok: false, reason: '空文件' };
+  if (buf.length > maxBytes) return { ok: false, reason: `太大（${Math.round(buf.length / 1048576)}MB）` };
+  const hash = crypto.createHash('sha256').update(buf).digest('hex');
+  return { ok: true, hash, bytes: buf.length, mime };
+}
+
+function loadUsed() {
+  try {
+    const raw = JSON.parse(fs.readFileSync(usedFile(), 'utf8'));
+    return raw && typeof raw === 'object' ? raw : {};
+  } catch { return {}; }
+}
+
+function saveUsed(map) {
+  try {
+    const file = usedFile();
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    const tmp = `${file}.${process.pid}.tmp`;
+    fs.writeFileSync(tmp, JSON.stringify(map), 'utf8');
+    fs.renameSync(tmp, file);
+  } catch { /* 记录失败不影响发帖 */ }
+}
+
+/** 这个哈希最近发过没有。 */
+export function seenRecently(hash, ttlMs = USED_TTL_MS) {
+  if (!hash) return false;
+  const map = loadUsed();
+  const at = Number(map[hash]?.at) || 0;
+  if (!at) return false;
+  if (Date.now() - at > ttlMs) return false;
+  return true;
+}
+
+/** 发成功后记一笔。顺带清掉过期项，文件不会无限长。 */
+export function remember(hash, url = '') {
+  if (!hash) return;
+  const map = loadUsed();
+  const now = Date.now();
+  for (const [k, v] of Object.entries(map)) {
+    if (now - (Number(v?.at) || 0) > USED_TTL_MS) delete map[k];
+  }
+  map[hash] = { at: now, url: String(url || '').slice(0, 300) };
+  saveUsed(map);
+}
