diff -ruN a/src/link-preview.js b/src/link-preview.js
--- a/src/link-preview.js	1970-01-01 08:00:00.000000000 +0800
+++ b/src/link-preview.js	2026-11-07 21:14:33.679365200 +0800
@@ -0,0 +1,166 @@
+// 链接预览：把标题、简介、作者、正文摘要从页面里抽出来。
+//
+// 为什么需要：web_fetch 只会把一整页 HTML 塞给模型，而小红书、抖音、公众号
+// 这类页面正文要登录才给，直接抓只会得到"页面不见了"四个字。这个模块做的事是
+// 尽量把 meta / JSON-LD / 页面内嵌状态里现成的字段捞出来，并在拿不到正文时
+// 明确标 bodyAvailable=false，让模型知道该去搜标题或者跟对方要截图，而不是瞎猜。
+import { safeFetch } from './safe-fetch.js';
+
+const MAX_BYTES = 2_000_000;
+const BODY_LIMIT = 4000;
+
+const PLATFORMS = [
+  [/xiaohongshu\.com|xhslink\.com/i, '小红书'],
+  [/douyin\.com|iesdouyin\.com/i, '抖音'],
+  [/bilibili\.com|b23\.tv/i, 'B站'],
+  [/weibo\.(com|cn)/i, '微博'],
+  [/zhihu\.com/i, '知乎'],
+  [/mp\.weixin\.qq\.com/i, '公众号'],
+  [/youtube\.com|youtu\.be/i, 'YouTube'],
+  [/github\.com/i, 'GitHub']
+];
+
+export function detectPlatform(url) {
+  for (const [re, name] of PLATFORMS) if (re.test(String(url || ''))) return name;
+  return '网页';
+}
+
+function decodeEntities(s) {
+  return String(s ?? '')
+    .replace(/&nbsp;/g, ' ')
+    .replace(/&amp;/g, '&')
+    .replace(/&lt;/g, '<')
+    .replace(/&gt;/g, '>')
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;|&apos;/g, "'")
+    .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16)))
+    .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)));
+}
+
+function plain(html) {
+  return decodeEntities(
+    String(html ?? '')
+      .replace(/<script[\s\S]*?<\/script>/gi, ' ')
+      .replace(/<style[\s\S]*?<\/style>/gi, ' ')
+      .replace(/<[^>]+>/g, ' ')
+  ).replace(/\s+/g, ' ').trim();
+}
+
+function metaMap(html) {
+  const out = {};
+  for (const m of String(html ?? '').matchAll(/<meta\b[^>]*>/gi)) {
+    const tag = m[0];
+    const key = (tag.match(/(?:property|name)\s*=\s*["']([^"']+)["']/i) || [])[1];
+    const val = (tag.match(/content\s*=\s*["']([^"']*)["']/i) || [])[1];
+    if (key && val) out[key.toLowerCase()] = decodeEntities(val);
+  }
+  return out;
+}
+
+function jsonLd(html) {
+  const found = [];
+  for (const m of String(html ?? '').matchAll(/<script[^>]+application\/ld\+json[^>]*>([\s\S]*?)<\/script>/gi)) {
+    try {
+      const data = JSON.parse(m[1].trim());
+      for (const item of Array.isArray(data) ? data : [data]) if (item && typeof item === 'object') found.push(item);
+    } catch { /* 脏 JSON 跳过 */ }
+  }
+  return found;
+}
+
+/** 页面里内嵌的 desc 字段（小红书笔记、部分站点都有）。 */
+function embeddedDesc(html) {
+  const m = String(html ?? '').match(/"desc"\s*:\s*("(?:[^"\\]|\\.){10,3000}")/);
+  if (!m) return '';
+  try {
+    return plain(JSON.parse(m[1]));
+  } catch {
+    return '';
+  }
+}
+
+function articleBody(html) {
+  const article = String(html ?? '').match(/<article\b[^>]*>([\s\S]{80,20000}?)<\/article>/i);
+  if (article) return plain(article[1]);
+  const wx = String(html ?? '').match(/<div[^>]+id=["']js_content["'][^>]*>([\s\S]{80,20000}?)<\/div>/i);
+  if (wx) return plain(wx[1]);
+  return '';
+}
+
+function tagsOf(text) {
+  const tags = [];
+  for (const m of String(text ?? '').matchAll(/#([^\s#\[\]【】]{1,20})/g)) {
+    const t = m[1].trim();
+    if (t && !tags.includes(t)) tags.push(t);
+  }
+  return tags.slice(0, 8);
+}
+
+/**
+ * 读一条链接，返回能读到的字段。读不到关键内容时抛错，由调用方转成提示。
+ * @param {string} rawUrl
+ * @param {{browseLocked?: boolean}} opts
+ */
+export async function readLink(rawUrl, { browseLocked = false } = {}) {
+  const input = String(rawUrl ?? '').trim();
+  if (!input) throw new Error('链接为空');
+  const startUrl = /^https?:\/\//i.test(input) ? input : `https://${input}`;
+  if (!/^https?:\/\//i.test(startUrl)) throw new Error('只支持 http(s) 链接');
+
+  // safeFetch 会逐跳跟随重定向（含短链），最终 url 以它返回的为准。
+  const res = await safeFetch(startUrl, { browseLocked, maxBytes: MAX_BYTES });
+  const html = String(res.body ?? '');
+  const finalUrl = String(res.url || startUrl);
+  const platform = detectPlatform(finalUrl);
+
+  const meta = metaMap(html);
+  const ld = jsonLd(html);
+  const ldArticle = ld.find((x) => typeof x?.articleBody === 'string') || {};
+  const ldAuthor = ld.map((x) => x?.author).find((a) => a && (typeof a === 'string' || a?.name));
+
+  const title = (meta['og:title'] || meta['twitter:title'] || ldArticle.headline
+    || (html.match(/<title[^>]*>([\s\S]{1,300}?)<\/title>/i) || [])[1] || '').trim();
+  const description = (meta['og:description'] || meta.description || meta['twitter:description'] || '').trim();
+
+  let body = String(ldArticle.articleBody || '').trim() || articleBody(html) || embeddedDesc(html);
+  body = plain(body).slice(0, BODY_LIMIT);
+
+  let author = '';
+  if (typeof ldAuthor === 'string') author = ldAuthor.trim();
+  else if (ldAuthor?.name) author = String(ldAuthor.name).trim();
+  if (!author) author = (meta.author || meta['og:article:author'] || '').trim();
+  if (!author) {
+    const nick = String(html).match(/"nickname"\s*:\s*"([^"]{1,40})"/);
+    if (nick) author = nick[1];
+  }
+
+  const cleanTitle = plain(title).replace(/\s*[-_|]\s*(小红书|哔哩哔哩|bilibili\.com|知乎|抖音|微博)\s*$/i, '');
+  const cleanDesc = plain(description);
+  if (!cleanTitle && !cleanDesc && !body) {
+    throw new Error(`页面没有可读内容（可能需要登录、或帖子已删除）：${platform}`);
+  }
+
+  // B 站/知乎这类站点对没有 JS 的请求会回一个「出错啦」页，标题本身就是错的，不能当内容用。
+  if (/^(出错啦|页面不存在|404|你访问的页面不见了|访问过于频繁)/.test(cleanTitle) && !cleanDesc) {
+    throw new Error(`${platform}这次没打开（被站点挡了或页面已经没了），别猜里面写了什么；可以让对方发截图或原文。`);
+  }
+
+  // 三十来个字的「正文」多半是页面骨架，不算真的读到内容。
+  const meaningful = body.length >= 120;
+  const note = meaningful
+    ? ''
+    : `${platform}这条只拿到标题和简介，正文需要登录或 App 内查看，别猜内容。`;
+
+  return {
+    ok: true,
+    url: finalUrl,
+    platform,
+    title: cleanTitle,
+    description: cleanDesc,
+    author,
+    tags: tagsOf(`${cleanTitle} ${cleanDesc}`),
+    body,
+    bodyAvailable: meaningful,
+    note
+  };
+}
