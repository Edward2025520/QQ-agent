+/**
+ * 搜狗结果页解析（h3.vr-title 里的标题 + 其后的摘要）。
+ * 它只在 DeepSeek 搜索连续失败时兜底用：拿得到标题就能让模型去核对，
+ * 拿不到结构化来源也比"搜索直接报错、模型只好凭记忆答"强。
+ */
+export function parseSogouResults(html, maxResults = 6) {
+  const out = [];
+  const seen = new Set();
+  const text = String(html ?? '');
+  const re = /<h3[^>]*class="[^"]*vr-title[^"]*"[^>]*>\s*<a[^>]*href="([^"]+)"[^>]*>([\s\S]{1,300}?)<\/a>/gi;
+  for (const m of text.matchAll(re)) {
+    let url = decodeHtml(m[1]);
+    if (url.startsWith('/')) url = 'https://www.sogou.com' + url;
+    const title = plainText(m[2]);
+    if (!title || seen.has(title)) continue;
+    seen.add(title);
+    const after = text.slice(m.index + m[0].length, m.index + m[0].length + 1500).split('<h3')[0];
+    const sn = after.match(/<(?:div|p)[^>]*class="[^"]*(?:str_info|str-text|text-layout|space-txt|fz-mid)[^"]*"[^>]*>([\s\S]{10,400}?)<\/(?:div|p)>/i);
+    out.push({ title, url, snippet: sn ? plainText(sn[1]) : '' });
+    if (out.length >= maxResults) break;
+  }
+  return out;
+}
+
+function plainText(html) {
+  return decodeHtml(String(html ?? '').replace(/<[^>]+>/g, ' ')).replace(/\s+/g, ' ').trim();
+}
+
+/** 搜狗搜索兜底。返回结构与 bingSearch 一致。 */
+export async function sogouSearch(query) {
+  const url = `https://www.sogou.com/web?query=${encodeURIComponent(sanitizeQuery(query))}`;
+  const res = await fetch(url, {
+    headers: {
+      'user-agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36',
+      'accept-language': 'zh-CN,zh;q=0.9'
+    },
+    signal: AbortSignal.timeout(15000)
