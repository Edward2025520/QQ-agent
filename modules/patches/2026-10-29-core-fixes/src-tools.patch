  * 看得到动图，读不了的会在网关报错后由 image-compat 的降级路径换首帧重试。
  */
+/**
+ * QQ 图片链接有时效（rkey 会过期），消息里存下来的 url 过一会儿就返回 400。
+ * 这时用协议端的 get_image 按 file 重新取一次地址 —— 实测同一文件能拿到有效链接。
+ * 返回新的 url；拿不到就返回空串。
+ */
+async function refreshImageUrl(onebot, file) {
+  if (!onebot || typeof onebot.call !== 'function' || !file) return '';
+  try {
+    const data = await onebot.call('get_image', { file });
+    const url = String(data?.file || data?.url || '');
+    if (url) console.log('[image] 链接过期，已用 get_image 刷新');
+    return url;
+  } catch (error) {
+    console.warn('[image] get_image 刷新失败:', error?.message ?? error);
+    return '';
+  }
+}
